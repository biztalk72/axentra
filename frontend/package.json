{
  "name": "forge-ax-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run check:locales && node --experimental-strip-types --test tests/*.test.mjs && npm run test:ui",
    "build:pages": "tsc -b && VITE_STATIC_DEMO=true vite build",
    "format": "prettier --write src vite.config.ts index.html *.json tests",
    "test:ui": "node --test tests/ui/*.test.mjs",
    "check:locales": "node ../scripts/check-ui-locales.mjs"
  },
  "dependencies": {
    "hls.js": "^1.7.4",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
