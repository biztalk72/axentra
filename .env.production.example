# Copy to .env.production. Keep that file outside Git.
# Use URL-safe letters/digits for the DB password: it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=ReplaceWithRandomDatabasePassword2026
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=ReplaceWithYourAdminPassword!2026
# false for a closed workspace; set true to allow operator self-registration.
ALLOW_REGISTRATION=false
# Loopback port for the console; terminate HTTPS at your existing ingress/reverse proxy.
WEB_PORT=8090
CORS_ORIGINS=http://127.0.0.1:8090
IMAGE_TAG=production
INSTALL_INTEGRATIONS=true
LLM_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=
INTEGRATION_BROKER_USERNAME=
INTEGRATION_BROKER_PASSWORD=
