# Local synthetic demo only. Replace passwords before deploying to a shared network.
POSTGRES_PASSWORD=ForgeDatabaseDemo2026
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=ChangeMeBeforeUse!2026
ALLOW_REGISTRATION=true
DEMO_MODE=true
DEMO_STREAM=true
WEB_PORT=8088

# Optional local LLM; model must already exist in your Ollama server.
LLM_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=

# Optional MQTT / Kafka / MCP SDK installation during API image build
INSTALL_INTEGRATIONS=false
# Broker credentials stay on the server; reference these names in the UI.
INTEGRATION_BROKER_USERNAME=
INTEGRATION_BROKER_PASSWORD=
